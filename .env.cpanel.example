APP_NAME=Vaultern
APP_ENV=production
APP_KEY=base64:KFvJn8VKEVlLtn2P8vSkCV6fAzi1pNh++//UyoIC9Os=
APP_DEBUG=false
APP_URL=https://apivaulternbackend.haaspes.space
APP_FRONTEND_URL=https://zumifly.app
APP_ALLOW_HTTP=false

# Requiere PHP 8.3+ en cPanel (MultiPHP Manager)

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL del hosting
# - En cPanel (mismo servidor): DB_HOST=localhost
# - Desde tu Mac (Remote MySQL): DB_HOST=148.113.168.25 + IP autorizada en cPanel
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=haaspess_vaultern-backend
DB_USERNAME=haaspess_vaultern-backend
DB_PASSWORD="COLOCA_TU_PASSWORD_AQUI"

# IMPORTANTE: contraseñas con # ; @ ^ * [ ] entre comillas dobles.
#
# Migrar desde el Mac (sin SSH):
#   export DB_HOST=148.113.168.25 DB_PASSWORD='...'
#   ./scripts/migrate-prod-from-local.sh

# --- cPanel: sin Redis, sin Reverb, sin Horizon ---
# Tiempo real en cPanel = FCM + soft refresh Flutter (BROADCAST_CONNECTION=log).
# Para Reverb/WebSockets migrar a VPS: ver docs/VPS_REALTIME.md (mismo código).
CACHE_STORE=file
FILESYSTEM_DISK=local
SESSION_DRIVER=cookie
# database = jobs en MySQL (recomendado) + cron schedule:run
# sync = todo en el request (más simple, APIs más lentas bajo carga)
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Correo cPanel
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.haaspes.space
MAIL_PORT=465
MAIL_USERNAME=no-reply@haaspes.space
MAIL_PASSWORD="COLOCA_TU_PASSWORD_AQUI"
MAIL_FROM_ADDRESS=no-reply@haaspes.space
MAIL_FROM_NAME="Zumifly"

# Permisos: chmod -R 775 storage bootstrap/cache

# Cron en cPanel (cada minuto):
# cd /home/USER/path/vaultern-backend && /usr/local/bin/php artisan schedule:run >> /dev/null 2>&1
# Eso ejecuta queue:work --stop-when-empty (ver bootstrap/app.php).

# Push FCM — subir storage/app/firebase-credentials.json
FIREBASE_FCM_ENABLED=true
FIREBASE_PROJECT_ID=pruebasflutter-b4e52

SANCTUM_STATEFUL_DOMAINS=localhost,apivaulternbackend.haaspes.space

# --- Mercado Pago Checkout Pro (Colombia) ---
# Credenciales solo en cPanel/.env — NUNCA en git.
# Panel MP → Webhooks: https://apivaulternbackend.haaspes.space/api/v1/webhooks/mercadopago
# En CO las keys de pestaña "Prueba" también son APP_USR-...; usa SANDBOX=true para tarjetas APRO.
MERCADOPAGO_ENABLED=true
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_API_BASE=https://api.mercadopago.com

