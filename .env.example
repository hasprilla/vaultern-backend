APP_NAME=Vaultern
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000
APP_ALLOW_HTTP=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vaultern_db
DB_USERNAME=vaultern
DB_PASSWORD=

# --- Target de producción: cPanel (sin Redis / sin Horizon) ---
# Cache y sesión en file/cookie. Cola en tabla MySQL `jobs`.
CACHE_STORE=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Broadcasting en cPanel: log o null (REST + FCM).
# Solo en máquina local con `php artisan reverb:start` usar: reverb
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Reverb solo desarrollo local (omitir en cPanel)
REVERB_APP_ID=vaultern
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

GOOGLE_VISION_API_KEY=

FIREBASE_FCM_ENABLED=false
FIREBASE_PROJECT_ID=pruebasflutter-b4e52
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,zumifly.app
